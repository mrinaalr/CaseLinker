# ---------------------------------------------------------------------------
# ML bundles, predictions, exports — ignore models/ except the triage bundle if you
# choose to commit it (optional). Corpus JSON / eval dumps stay local — not in git.
# ---------------------------------------------------------------------------
models/*
!models/triage_bundle.joblib

# JSON data dumps (corpus predictions, extract_evaluation.json, semantic exports, etc.)
# Whitelist only standard JS/TS config files and the authored Case Studies content.
*.json
!package.json
!package-lock.json
!tsconfig.json
!jsconfig.json
# Case Studies authored content (read by the /case-studies tab and the /api/case-studies
# endpoint). Must ship with the deploy or Railway shows "No content yet."
!data/case_studies.json
# Snapshot manifest schema. JSON is ignored by default above.
!tests/snapshot-manifest-v1.schema.json
# Grounding precision freeze + sentence judgments (must travel with code)
!scripts/verify/extraction/hint_source_policy.json
!scripts/verify/extraction/location_precision_*.json
!scripts/verify/extraction/agency_precision_*.json
# Working packs used while judging (ids + judgments.jsonl are the published artifacts)
scripts/verify/extraction/grounding_holdout_*_pack.jsonl
# NZ DIA build input: single-person scrapes plus split two-person releases.
!collector/sources/nzdia_csea_resolved.json
# Local claim-snapshot output from verify_paper --snapshot
scripts/verify/paper/snapshot/
# Platform affordance evidence — authored + generated artifacts ship with deploy.
!ontology/platform_affordance_evidence/
!ontology/platform_affordance_evidence/*.json
!ontology/q2/
!ontology/q2/*.json
!ontology/q3/
!ontology/q3/*.json
# State machines: code, codebook, schema and released data are tracked; caches are not.
state_machines/**/__pycache__/
# NOTE: data/case_study_notes.json is intentionally NOT whitelisted. It holds
# user-submitted community notes; committing it would overwrite live notes on every
# deploy. The loader returns [] when the file is absent, which is the correct default
# on Railway's ephemeral filesystem. Mount a volume or swap to the DB for durability.

# Serialized models / checkpoints (also covered by models/; these catch stray files)
*.joblib
!models/triage_bundle.joblib
*.jbl
*.pkl
*.pickle
*.pt
*.pth
*.onnx
*.safetensors
*.h5
*.keras
*.npy
*.npz

# Keys / secrets
*.pem
*.key
credentials/
secrets/

# Local Oxigraph store + CLI binary (rebuild from N-Quads backups)
caselinker_oxigraph/
.tools/oxigraph
*.nq

# Gazetteer/agency pin dirs: keep MANIFEST + pinned national snapshots tracked
data/gazetteer/*
!data/gazetteer/MANIFEST.json
!data/gazetteer/2024_Gaz_state_national.txt
!data/gazetteer/2024_Gaz_counties_national.txt
!data/gazetteer/2024_Gaz_place_national.txt
data/agency_registry/*
!data/agency_registry/MANIFEST.json
!data/agency_registry/federal_agencies.json
!data/agency_registry/cde_agencies_*.json
scripts/verify/extraction/_grounding_out/

# Local config overrides (not for deploy)
config/

# Temporary files
*.tmp
*.temp

# Ontology merged graph caches (rebuilt locally / on Railway)
ontology/cache/

# Scraper working state (URL diffs, CAC verify CSVs, tmp PDFs) — local only
collector/state/

# Collector run output (PDFs, dual-path test packs). Local only.
collector_output/
scrape_output/

# Age-extraction review sheets and full-text sidecars. Local only.
scripts/verify/extraction/output/

# ---------------------------------------------------------------------------
# PACER — raw court OCR/screenshots stay local; CASE-UCO SDK JSON-LD ships.
# PDFs at repo root / BULK_FOLDER are already covered by *.pdf above.
# ---------------------------------------------------------------------------
# PACER source documents stay local (court records); graphs live in state_machines/data/<release>/
ontology/PACER/**
!ontology/PACER/
!ontology/PACER/README.md
!ontology/PACER/BULK_FOLDER/
!ontology/PACER/BULK_FOLDER/pacer_cost.csv

# PACER evidence work: page text, quote store and adjudication packets stay local (court text)
.venv-*/
local/
!state_machines/evidence/schema/*.json
!state_machines/data/**/*.json
!state_machines/data/**/*.jsonld
# coded bundles hold coder-written text: never committed (explicit, not via the case-insensitive Cases/ rule)
state_machines/data/*/cases/
!state_machines/graphs/*.json
!state_machines/coding/models.json
!state_machines/observations/seal_config.json
!state_machines/benchmark/data/**/*.json
state_machines/benchmark/data/*/quotes.json
!state_machines/benchmark/results/*.json

# AfH 2.0 Q1 reconstruction: configs, outputs, the text-free public snapshot and the era registry
# are committed; the full-text snapshot under ontology/platform_affordance_evidence/afh_manifest/data/ is not.
!ontology/platform_affordance_evidence/afh_manifest/config/
!ontology/platform_affordance_evidence/afh_manifest/snapshots.json
!ontology/platform_affordance_evidence/afh_manifest/config/capability_sources/url_check.json
# AfH 2.0 numbers: code and text-free outputs ship (build/, harm tables, co-occurrence, numbers.json/.md)
!ontology/platform_affordance_evidence/afh_manifest/numbers/build/
!ontology/platform_affordance_evidence/afh_manifest/numbers/**/*.json
