        {
            "@id": "kb:enterprise",
            "@type": "uco-identity:Organization",
            "uco-core:description": "Association-in-fact enterprise charged under 18 U.S.C. \u00a7 2252A(g). An Internet-based group that operated in or about and between 2019 and 2021 throughout the United States, including in the Eastern District of New York, whose members exploited minor victims by, among other things, inducing them to produce child pornography. Charged purposes included producing, advertising, receiving, distributing, possessing and accessing child pornography with intent to view; online exploitation and harassment through intimidation, threats of public shaming and property damage, and extortion; placing adult and minor victims in fear of the enterprise; and concealing enterprise activity from law enforcement. Source: PACER Doc 8 (redacted indictment), paras. 1-7.",
            "uco-core:name": "Greggy's Cult"
        },
        {
            "@id": "kb:rel-inv-enterprise",
            "@type": "uco-core:Relationship",
            "uco-core:source": [
                {
                    "@id": "kb:investigation"
                }
            ],
            "uco-core:target": [
                {
                    "@id": "kb:enterprise"
                }
            ],
            "uco-core:kindOfRelationship": "Related_To",
            "uco-core:isDirectional": {
                "@type": "xsd:boolean",
                "@value": "true"
            },
            "uco-core:description": "Investigation concerns this charged enterprise"
        },
        {
            "@id": "kb:target-server",
            "@type": "uco-observable:ObservableObject",
            "uco-core:description": "A series of related Discord servers collectively referred to in the indictment as the Target Server. Discord servers are digital spaces made up of channels; the Target Server contained several channels, certain of which were locked so that only Greggy's Cult members were authorized to access them. Members trafficked child pornography, sexually exploited minors, and communicated interstate threats on the Target Server. Source: PACER Doc 8 (redacted indictment), paras. 3-4.",
            "uco-core:name": "Target Server (Greggy's Cult Discord servers)"
        },
        {
            "@id": "kb:rel-enterprise-server",
            "@type": "uco-core:Relationship",
            "uco-core:source": [
