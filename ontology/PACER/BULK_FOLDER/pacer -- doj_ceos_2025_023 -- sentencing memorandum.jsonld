      "uco-core:description": "PACER/ECF case number: 2:24-cr-00047-DLB-CJS",
      "uco-core:eventContext": [
        {
          "@id": "urn:uuid:3c0cbca0-16c0-52f8-b51c-24349f814937"
        },
        {
          "@id": "urn:uuid:fc479f0d-02e5-5de1-8022-a00985653c49"
