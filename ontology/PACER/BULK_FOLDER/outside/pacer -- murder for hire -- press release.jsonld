    {
      "@id": "urn:uuid:eed9c02d-112c-5456-a69b-2b52551a2629",
      "@type": "uco-observable:ObservableObject",
      "uco-core:name": "Statute 18 U.S.C. \u00a71958",
      "uco-core:description": "18 U.S.C. \u00a71958",
      "uco-core:hasFacet": [
        {
