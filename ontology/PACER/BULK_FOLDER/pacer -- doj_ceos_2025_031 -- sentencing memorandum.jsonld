    {
      "@id": "urn:uuid:357aa99b-c037-5aaa-8a3f-ad9b6842d040",
      "@type": "uco-core:Event",
      "uco-core:name": "Law-enforcement charge or arrest narrative",
      "uco-core:eventType": [
        "criminal charge",
        "law-enforcement narrative"
      ],
      "uco-core:description": "he sexual abuse of children are incalculably serious. Offenders who\n\ntraffic in child pornography inflict grave, lifelong trauma on their victims. And far too often, these\n\nvictims go unidentified, meaning their suffe",
      "uco-core:eventContext": [
        {
          "@id": "urn:uuid:057454c7-e20d-5ebd-887a-5388e9842902"
        },
        {
          "@id": "urn:uuid:2710a6d3-7b40-5c1f-842f-40e39aaeea77"
        },
        {
          "@id": "urn:uuid:400ffe5e-8319-5ce4-a455-c80917138f51"
        },
        {
          "@id": "urn:uuid:ee43926f-f608-5b01-8d1a-d4870450020a"
        },
        {
          "@id": "urn:uuid:17a87756-ed03-5545-b831-a07a22f1cdd3"
        },
        {
