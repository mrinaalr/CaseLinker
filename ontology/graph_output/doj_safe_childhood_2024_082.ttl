<https://caselinker.up.railway.app/resource/case/doj_safe_childhood_2024_082/admission/1> a cacontology-undercover:IncriminatingStatement ;
    rdfs:label "engaging in sexually explicit conduct with at least one minor for the purpose of producing a visual depiction of that..." ;
    dcterms:source <https://www.justice.gov/usao-edky/pr/northern-kentucky-man-pleads-guilty-extraterritorial-production-child-pornography> ;
    ns1:admissionContext "abuse material (CSAM) and multiple inIperson meetings with minor boys in the Philippines. Specifically, Werner admitted to engaging in se..." ;
    ns1:admissionFrame "admitted_to" ;
    ns1:admissionTheme "harm_conduct" ;
    ns1:attributedToOffenderRole <https://caselinker.up.railway.app/resource/case/doj_safe_childhood_2024_082/role/offender/1> ;
    ns1:evidenceTier "press_release_stated" ;
    ns1:quoteType "paraphrase" ;
    uco-core:description "engaging in sexually explicit conduct with at least one minor for the purpose of producing a visual depiction of that conduct between July 2021 and November 2021, while in the Philippines" .

