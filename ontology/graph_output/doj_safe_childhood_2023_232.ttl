<https://caselinker.up.railway.app/resource/case/doj_safe_childhood_2023_232/admission/1> a cacontology-undercover:IncriminatingStatement ;
    rdfs:label "had engaged in sexual acts with approximately 24 different minor females with ages ranging from 11 to 17 years old in..." ;
    dcterms:source <https://www.justice.gov/usao-id/pr/oklahoma-man-sentenced-28-years-federal-prison-producing-child-pornography> ;
    ns1:admissionContext "ntercourse with the child in Elko and used his cellphone to make a recording of the acts. Mahoney further admitted that he had engaged in..." ;
    ns1:admissionFrame "admitted_paraphrase" ;
    ns1:admissionTheme "harm_conduct" ;
    ns1:attributedToOffenderRole <https://caselinker.up.railway.app/resource/case/doj_safe_childhood_2023_232/role/offender/1> ;
    ns1:evidenceTier "press_release_stated" ;
    ns1:quoteType "paraphrase" ;
    uco-core:description "had engaged in sexual acts with approximately 24 different minor females with ages ranging from 11 to 17 years old in eight different states between August and November 2021" .

<https://caselinker.up.railway.app/resource/case/doj_safe_childhood_2023_232/admission/2> a cacontology-undercover:IncriminatingStatement ;
    rdfs:label "had sexual intercourse with the child in Elko and used his cellphone to make a recording of the acts" ;
    dcterms:source <https://www.justice.gov/usao-id/pr/oklahoma-man-sentenced-28-years-federal-prison-producing-child-pornography> ;
    ns1:admissionContext "-old child. Mahoney admitted that he met the child on the Snapchat messaging application. He admitted that he had sexual intercourse with..." ;
    ns1:admissionFrame "he_admitted_paraphrase" ;
    ns1:admissionTheme "harm_conduct" ;
    ns1:attributedToOffenderRole <https://caselinker.up.railway.app/resource/case/doj_safe_childhood_2023_232/role/offender/1> ;
    ns1:evidenceTier "press_release_stated" ;
    ns1:quoteType "paraphrase" ;
    uco-core:description "had sexual intercourse with the child in Elko and used his cellphone to make a recording of the acts" .

