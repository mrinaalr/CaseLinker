<https://caselinker.up.railway.app/resource/case/ncmec_2025_1017/admission/2> a cacontology-undercover:IncriminatingStatement ;
    rdfs:label "being part of groups involved in child sex- abuse materials and used the groups to obtain the materials and to send m..." ;
    dcterms:source <https://www.timesargus.com/news/local/northfield-man-accused-of-possessing-child-sex-abuse-materials/article_7a218a62-d2a9-11ef-bb5f-bb40df96a744.html> ;
    ns1:admissionContext "child sex-abuse materials, but later admitted he had been sent such materials on Kik. The detective said Pierce admitted to being part of..." ;
    ns1:admissionFrame "admitted_to" ;
    ns1:admissionTheme "harm_conduct" ;
    ns1:attributedToOffenderRole <https://caselinker.up.railway.app/resource/case/ncmec_2025_1017/role/offender/1> ;
    ns1:evidenceTier "press_release_stated" ;
    ns1:quoteType "paraphrase" ;
    uco-core:description "being part of groups involved in child sex- abuse materials and used the groups to obtain the materials and to send materials to others in the groups" .

