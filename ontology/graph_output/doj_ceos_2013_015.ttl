    ns1:attributedToOffenderRole <https://caselinker.up.railway.app/resource/case/doj_ceos_2013_015/role/offender/1> ;
    ns1:evidenceTier "press_release_stated" ;
    ns1:quoteType "paraphrase" ;
    uco-core:description "sexually abusing another young boy in Athens County several years ago and discussing that abuse with the individual, a sex offender in Massachusetts, to whom he sent the videos" .

