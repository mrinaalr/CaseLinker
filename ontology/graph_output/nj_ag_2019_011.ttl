<https://caselinker.up.railway.app/resource/case/nj_ag_2019_011/admission/1> a cacontology-undercover:IncriminatingStatement ;
    rdfs:label "knowingly used file-sharing software to make multiple files of child pornography readily available for any other user..." ;
