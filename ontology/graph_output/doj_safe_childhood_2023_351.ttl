    ns1:attributedToOffenderRole <https://caselinker.up.railway.app/resource/case/doj_safe_childhood_2023_351/role/offender/1> ;
    ns1:evidenceTier "press_release_stated" ;
    ns1:quoteType "paraphrase" ;
    uco-core:description "receiving specific images via the internet in May 2016, knowing that they contained child pornography" .

