<https://caselinker.up.railway.app/resource/case/ncmec_2022_129/admission/1> a cacontology-undercover:IncriminatingStatement ;
    rdfs:label "viewing child sexual abuse materials for two years, the complaint says" ;
    dcterms:source <https://www.timesleader.com/news/1565306/dennison-township-man-charged-with-sharing-child-sexual-abuse-materials> ;
    ns1:admissionContext "related DUI warrant. He spoke with detectives after he waived his right to remain silent. During the interview, O’Connor admitted to view..." ;
    ns1:admissionFrame "admitted_to" ;
    ns1:admissionTheme "harm_conduct" ;
    ns1:attributedToOffenderRole <https://caselinker.up.railway.app/resource/case/ncmec_2022_129/role/offender/1> ;
    ns1:evidenceTier "press_release_stated" ;
    ns1:quoteType "paraphrase" ;
    uco-core:description "viewing child sexual abuse materials for two years, the complaint says" .

<https://caselinker.up.railway.app/resource/case/ncmec_2022_129/admission/2> a cacontology-undercover:IncriminatingStatement ;
    rdfs:label "using his friends and a local restaurant’s WIFI to access the internet" ;
    dcterms:source <https://www.timesleader.com/news/1565306/dennison-township-man-charged-with-sharing-child-sexual-abuse-materials> ;
    ns1:admissionContext "-sex acts only later to feel awful about it as he knew it was wrong, the complaint says. Detectives in the complaint reported O’Connor ad..." ;
    ns1:admissionFrame "admitted_to" ;
    ns1:admissionTheme "tech_use" ;
    ns1:attributedToOffenderRole <https://caselinker.up.railway.app/resource/case/ncmec_2022_129/role/offender/1> ;
    ns1:evidenceTier "press_release_stated" ;
    ns1:quoteType "paraphrase" ;
    uco-core:description "using his friends and a local restaurant’s WIFI to access the internet" .

<https://caselinker.up.railway.app/resource/case/ncmec_2022_129/admission/3> a cacontology-undercover:IncriminatingStatement ;
    rdfs:label "was under the influence of methamphetamine when he would got into chat rooms and likely performed self-sex acts only ..." ;
    dcterms:source <https://www.timesleader.com/news/1565306/dennison-township-man-charged-with-sharing-child-sexual-abuse-materials> ;
    ns1:admissionContext "eiving and sharing images of children involved in sex acts, according to the complaint. O’Connor said he was under the influence of metha..." ;
    ns1:admissionFrame "said_paraphrase" ;
    ns1:admissionTheme "tech_use" ;
    ns1:attributedToOffenderRole <https://caselinker.up.railway.app/resource/case/ncmec_2022_129/role/offender/1> ;
    ns1:evidenceTier "press_release_stated" ;
    ns1:quoteType "paraphrase" ;
    uco-core:description "was under the influence of methamphetamine when he would got into chat rooms and likely performed self-sex acts only later to feel awful about it as he knew it was wrong, the complaint says" .

