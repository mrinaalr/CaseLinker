<https://caselinker.up.railway.app/resource/case/ncmec_2022_130/admission/1> a cacontology-undercover:IncriminatingStatement ;
    rdfs:label "viewing child sexual abuse materials for two years, the complaint says" ;
    dcterms:source <https://www.timesleader.com/news/1565306/dennison-township-man-charged-with-sharing-child-sexual-abuse-materials> ;
    ns1:admissionContext "related DUI warrant. He spoke with detectives after he waived his right to remain silent. During the interview, O’Connor admitted to view..." ;
    ns1:admissionFrame "admitted_to" ;
    ns1:admissionTheme "harm_conduct" ;
    ns1:attributedToOffenderRole <https://caselinker.up.railway.app/resource/case/ncmec_2022_130/role/offender/1> ;
