<https://caselinker.up.railway.app/resource/case/ncmec_2025_1051/admission/1> a cacontology-undercover:IncriminatingStatement ;
    rdfs:label "had been locked out of his Google account last fall and was notified it was due to downloading inappropriate pictures" ;
    dcterms:source <https://www.dailyrecordnews.com/crimes/cle-elum-man-accused-of-dealing-child-porn-asks-for-new-lawyer/article_6e375979-85d4-47cc-8371-14173dd2dfb6.html> ;
    ns1:admissionContext "s he looked at a lot of adult pornography online and spent a lot of time on the internet. Neifert allegedly admitted he had been locked o..." ;
    ns1:admissionFrame "admitted_he_she" ;
    ns1:admissionTheme "tech_use" ;
    ns1:attributedToOffenderRole <https://caselinker.up.railway.app/resource/case/ncmec_2025_1051/role/offender/1> ;
    ns1:evidenceTier "press_release_stated" ;
    ns1:quoteType "paraphrase" ;
    uco-core:description "had been locked out of his Google account last fall and was notified it was due to downloading inappropriate pictures" .

<https://caselinker.up.railway.app/resource/case/ncmec_2025_1051/admission/2> a cacontology-undercover:IncriminatingStatement ;
    rdfs:label "did not agree with his desire to claim “not guilty by reason of insanity,” he wrote in his memo" ;
    dcterms:source <https://www.dailyrecordnews.com/crimes/cle-elum-man-accused-of-dealing-child-porn-asks-for-new-lawyer/article_6e375979-85d4-47cc-8371-14173dd2dfb6.html> ;
    ns1:admissionContext "itnesses, and actual witnesses who could prove my innocense [sic],” he wrote in the memo. Neifert said she did not agree with his desire..." ;
    ns1:admissionFrame "said_paraphrase" ;
    ns1:admissionTheme "minimization" ;
    ns1:attributedToOffenderRole <https://caselinker.up.railway.app/resource/case/ncmec_2025_1051/role/offender/1> ;
    ns1:evidenceTier "press_release_stated" ;
    ns1:quoteType "paraphrase" ;
    uco-core:description "did not agree with his desire to claim “not guilty by reason of insanity,” he wrote in his memo" .

