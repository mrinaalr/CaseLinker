    ns1:admissionContext "2019, at his residence at the Intown Suites Hotel in Macon, where he was also employed. Brown admitted he threatened the girl in order to..." ;
    ns1:admissionFrame "admitted_he_she" ;
    ns1:admissionTheme "tech_use" ;
    ns1:attributedToOffenderRole <https://caselinker.up.railway.app/resource/case/doj_safe_childhood_2022_403/role/offender/1> ;
