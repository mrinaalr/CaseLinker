<https://caselinker.up.railway.app/resource/case/doj_safe_childhood_2022_403/admission/1> a cacontology-undercover:IncriminatingStatement ;
    rdfs:label "threatened the girl in order to receive her Facebook passwords and assumed her identity on Facebook, chatting with he..." ;
