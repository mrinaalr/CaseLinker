<https://caselinker.up.railway.app/resource/case/doj_ceos_2013_139/admission/1> a cacontology-undercover:IncriminatingStatement ;
    rdfs:label "had taken that picture and that the girl in the second image also had been about 12 years old at the time" ;
    dcterms:source <https://www.justice.gov/usao-mdfl/pr/sanford-missionary-pleads-guilty-producing-child-pornography> ;
    ns1:admissionContext "rl was about 12 years old at the time the picture was taken. When shown the second image, Kennell admitted that he had taken that picture..." ;
    ns1:admissionFrame "admitted_paraphrase" ;
    ns1:admissionTheme "other" ;
    ns1:attributedToOffenderRole <https://caselinker.up.railway.app/resource/case/doj_ceos_2013_139/role/offender/1> ;
    ns1:evidenceTier "press_release_stated" ;
    ns1:quoteType "paraphrase" ;
    uco-core:description "had taken that picture and that the girl in the second image also had been about 12 years old at the time" .

<https://caselinker.up.railway.app/resource/case/doj_ceos_2013_139/admission/2> a cacontology-undercover:IncriminatingStatement ;
    rdfs:label "had worked in Brazil as a missionary for the New Tribes Mission, in Sanford, Florida, and that he had been doing miss..." ;
    dcterms:source <https://www.justice.gov/usao-mdfl/pr/sanford-missionary-pleads-guilty-producing-child-pornography> ;
    ns1:admissionContext "belongings and found three thumb drives and one external hard drive. During an interview, Kennell said that he had worked in Brazil as a..." ;
    ns1:admissionFrame "said_paraphrase" ;
    ns1:admissionTheme "other" ;
    ns1:attributedToOffenderRole <https://caselinker.up.railway.app/resource/case/doj_ceos_2013_139/role/offender/1> ;
    ns1:evidenceTier "press_release_stated" ;
    ns1:quoteType "paraphrase" ;
    uco-core:description "had worked in Brazil as a missionary for the New Tribes Mission, in Sanford, Florida, and that he had been doing missionary work for several years" .

<https://caselinker.up.railway.app/resource/case/doj_ceos_2013_139/admission/3> a cacontology-undercover:IncriminatingStatement ;
    rdfs:label "believed the girl was about 12 years old at the time the picture was taken" ;
    dcterms:source <https://www.justice.gov/usao-mdfl/pr/sanford-missionary-pleads-guilty-producing-child-pornography> ;
    ns1:admissionContext "edged that he was the man in the picture performing a sex act on the prepubescent female. Kennell said that he believed the girl was abou..." ;
